# Copy to deploy/.env.production after pushing images. Every application image must
# be pinned by repository digest; tags alone are intentionally not accepted here.
DATABASE_MIGRATION_IMAGE=registry.example.com/easy1auth/database-migration@sha256:REPLACE
ADMIN_API_IMAGE=registry.example.com/easy1auth/admin-api@sha256:REPLACE
AUTHORIZATION_SERVER_IMAGE=registry.example.com/easy1auth/authorization-server@sha256:REPLACE
GATEWAY_IMAGE=registry.example.com/easy1auth/gateway@sha256:REPLACE

ADMIN_JWT_ISSUER=https://admin.example.com
OAUTH2_ISSUER_BASE=https://auth.example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=465
REGISTRATION_FROM_ADDRESS=no-reply@example.com
GATEWAY_PORT=8080
MAINTENANCE_MODE=on
